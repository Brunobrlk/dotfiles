# ------------------------
# App launchers
# ------------------------

# Android Studio
super + a
    /home/brunobrlk/Src/AndroidStudio/android-studio-narwhal/bin/studio %f

# DBeaver
super + b
    flatpak run io.dbeaver.DBeaverCommunity

# Email Client
super + e
    thunderbird

# Browser
super + g
    flatpak run com.brave.Browser

# Insomnia
super + i
    flatpak run rest.insomnia.Insomnia

# File Manager
super + o
    nemo

# Postman
super + p
    flatpak run com.getpostman.Postman

# Todoist
super + q
    flatpak run com.todoist.Todoist

# Terminal (fullscreen + tmux)
super + t
    alacritty -e tmux

# VS Code
super + v
    flatpak run com.visualstudio.code

# Next wallpaper (custom script)
super + w
    random_wallpaper

# ------------------------
# Tools & screenshots
# ------------------------

# Rofi App Launcher
super + Return
    rofi-launcher

# Rofi Bookmarks
super + shift + Return
    rofi-bookmarks

# Rofi Powermenu
super + BackSpace
    rofi-powermenu

# Rofi Mpd
super + r
    rofi-mpd

# Rofi Clipboard History
super + shift + BackSpace
    rofi-clipboard

# Flameshot (region = current monitor)
Print
    flameshot gui --region 1920x1080+0+0

# Flameshot (free selection)
shift + Print
    flameshot gui
