# ------------------------
# App launchers
# ------------------------

# Android Studio
super + a
    /home/brunobrlk/Src/AndroidStudio/android-studio-narwhal/bin/studio %f

# DBeaver
super + b
    flatpak run io.dbeaver.DBeaverCommunity

# Email Client
super + e
    thunderbird

# Browser
super + g
    flatpak run com.brave.Browser

# Insomnia
super + i
    flatpak run rest.insomnia.Insomnia

# File Manager
super + o
    nemo

# Postman
super + p
    flatpak run com.getpostman.Postman

# Todoist
super + q
    flatpak run com.todoist.Todoist

# Terminal (fullscreen + tmux)
super + t
    alacritty -e tmux

# VS Code
# super + v
#     flatpak run com.visualstudio.code

# Next wallpaper (custom script)
super + w
    /home/brunobrlk/.local/bin/random-wallpaper

# ------------------------
# Tools & screenshots
# ------------------------

# Rofi App Launcher
super + Return
    /home/brunobrlk/.local/bin/rofi-launcher

# Rofi Bookmarks
super + shift + Return
    /home/brunobrlk/.local/bin/rofi-bookmarks

# Rofi Powermenu
super + BackSpace
    /home/brunobrlk/.local/bin/rofi-powermenu

# Rofi Mpd
super + r
    /home/brunobrlk/.local/bin/rofi-mpd

# Rofi Clipboard History
super + shift + BackSpace
    /home/brunobrlk/.local/bin/rofi-clipboard

# Flameshot (region = current monitor)
Print
    flameshot gui --region 1920x1080+0+0

# Flameshot (free selection)
shift + Print
    flameshot gui
