" =========================
" General Options
" =========================
let mapleader=" "
imap jk <ESC>
set scrolloff=8

" =========================
" Editing
" =========================
" Create File | Create Package | Create Template => If Conflicts, migrate to Add File / Add Package using af and ap
" map <leader>co <Action>(CollapseRegion)
map <leader>nf <Action>(Kotlin.NewFile)
map <leader>np <Action>(NewDir)
map <leader>nt <Action>(NewFromTemplate)

map <A-k> <Action>(MoveStatementUp)
map <A-j> <Action>(MoveStatementDown)
map <leader>/ <Action>(CommentByLineComment)

" =========================
" [B]uild (Gradle)
" =========================
map <leader>br <action>(RebuildGradleProject)
map <leader>bc <Action>(CleanGradleProject)
map <leader>bs <Action>(Android.SyncProject)
map <leader>bi <Action>(InvalidateCaches)
map <leader>ba <Action>(MakeGradleProject)

" =========================
" [G]it
" =========================
" map <leader>gl <Action>(ActivateVersionControlToolWindow)
map <leader>gd <Action>(Compare.SameVersion)

" =========================
" [T]ools (Windows)
" =========================
map <leader>e <Action>(ActivateProjectToolWindow)
map <leader>c <Action>(CloseContent)
map <leader>h <Action>(HideAllWindows)
map <leader>sv <Action>(MoveTabRight)
map <leader>sh <Action>(MoveTabDown)
map <leader>st <Action>(FindInPath)
map <leader>sf <Action>(SearchEverywhere)

" =========================
" [R]un
" =========================
map <leader>rr <Action>(Run)
map <leader>rs <Action>(Stop)
map <leader>re <Action>(android.deploy.ApplyChanges)
map <leader>rc <Action>(android.deploy.CodeSwap)
map <leader>rd <Action>(Debug)
map <leader>ra <Action>(AndroidConnectDebuggerAction)

" =========================
" [L]sp (IDE) Actions
" =========================
map <leader>li <Action>(InspectCode)
map <leader>lo <Action>(IntentionActionAsAction_com.intellij.codeInsight.daemon.impl.analysis.RearrangeAttributesIntention)
map <leader>l1 <Action>(Android.Designer.CommonActions.ForceCompileAndRefreshActionForNotification)
map <leader>l2 <Action>(ForceRefresh)

" =========================
" Handlers
" =========================
sethandler <C-2> a:ide
sethandler <C-S-2> a:ide
sethandler <C-A> a:vim
sethandler <C-B> a:ide
sethandler <C-C> a:ide
sethandler <C-D> a:vim
sethandler <C-E> a:vim
sethandler <C-F> a:ide
sethandler <C-G> a:vim
sethandler <C-H> a:ide
sethandler <C-I> a:ide
sethandler <C-J> a:ide
sethandler <C-L> a:ide
sethandler <C-M> a:vim
sethandler <C-N> a:vim
sethandler <C-O> a:ide
sethandler <C-P> a:ide
sethandler <C-Q> a:ide
sethandler <C-R> a:vim
sethandler <C-S> a:vim
sethandler <C-U> a:vim
sethandler <C-V> a:ide
sethandler <C-W> a:ide
sethandler <C-X> a:vim
sethandler <C-\> a:ide