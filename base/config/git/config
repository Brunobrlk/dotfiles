[user]
	name = Bruno Guimarães
	email = brunoguimaraes.dev@gmail.com

[core]
    editor = lvim

[commit]
    template = ~/.config/git/conventional-commits
    gpgSign = true

[pull]
	ff = true

[log]
    abbrevCommit = true
    graphColors = blue,yellow,cyan,magenta,green,red

[status]
    showStash = true

[diff]
    context = 3
    renames = copies
    interHunkContext = 10

[diff-so-fancy]
    markEmptyLines = false

[pager]
    diff = diff-so-fancy | less
    branch = false
    tag = false

[interactive]
    diffFilter = diff-so-fancy --patch
    singlekey = true

[color "diff"]
    meta = black bold
    frag = magenta
    context = white
    whitespace = yellow reverse
    old = red

[color "branch"]
    current = magenta
    local = magenta
    remote = yellow
    upstream = green
    plain = blue

[alias]
    conf = config --global --edit

    s = status
    ss = status -s

    st = stash
    stls = stash list
    stpop = stash pop
    stapply = stash apply
    strm = stash drop

    dfs = diff --staged

    unstage = restore --staged .

    aa = add -A
    cm = commit
    cma = "!f() { if [ -z \"$1\" ]; then echo 'Error: commit message required'; else git add -A && git commit -m \"$1\"; fi; }; f"
    amend = commit --amend --no-edit

    pullr = pull --rebase
    pushf = push --force-with-lease

    l = log --pretty='format:%C(green)%ad %C(yellow)%h %C(ul cyan)%an%C(no-ul red) %d%n%C(white)%B' --date='format:%y-%m/%d %H:%m'
    ll = log --pretty='format:%C(green)%ad %C(yellow)%h %C(cyan)%an %C(white)%s %C(red)%d' --date='format:%y-%m/%d %H:%m'
    lg = log --graph --pretty='format:%C(green)%ad %C(yellow)%h %C(cyan)%an %C(white)%s %C(red)%d' --date='format:%y-%m/%d %H:%m'

    b = branch
    ba = branch -a
    brm = branch -d 

    ch = checkout
    clforce = clean -df

    wtls = worktree list
    wtadd = worktree add
    wtrm = worktree remove
    wtb = "!f() { if [ -z \"$1\" ]; then echo 'Error: Branch name is required'; else git worktree add ../$(basename $(pwd))-$(echo $1 | tr '/' '-'); fi; }; f"

# URL Shortcuts
[url "git@github.com:Brunobrlk/"]
    insteadOf = "Brunobrlk:"

[url "git@github.com:Brunobrlk/"]
    insteadOf = "brunobrlk:"

[url "git@github.com:"]
    insteadOf = "gh:"

[include]
    path = ~/.local/share/secure/git/config.local
