}
rmc() {
    printf '%s\n' "$@"
    read -rp "Delete these files? [y/N] " confirm
    [[ $confirm == [yY] ]] && rm -- "$@"
}

# Best video + best audio + embedded English subtitles to ~/Videos
alias ytv='yt-dlp -f "bv*+ba/b" -P "$HOME/Videos" --merge-output-format mkv --write-subs --write-auto-subs --sub-langs "^en$" --sub-format "srt/best" --convert-subs srt --embed-subs --compat-options no-keep-subs --sleep-subtitles 2'

# Best video + best audio, no subtitles, to ~/Videos
alias ytvonly='yt-dlp -f "bv*+ba/b" -P "$HOME/Videos" --merge-output-format mkv --no-write-subs --no-write-auto-subs --no-embed-subs'

# Best audio as MP3 to ~/Music
alias ytaonly='yt-dlp -f "ba/b" -P "$HOME/Music" -x --audio-format mp3 --audio-quality 0 --no-write-subs --no-write-auto-subs --no-embed-subs'

# Best audio as MP3 + embedded thumbnail to ~/Music
alias yta='yt-dlp -f "ba/b" -P "$HOME/Music" -x --audio-format mp3 --audio-quality 0 --embed-thumbnail --no-write-subs --no-write-auto-subs --no-embed-subs'

