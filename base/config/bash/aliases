# Add an "alert" alias for long running commands.  Use like so: $ sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

alias ollama-update='curl -fsSL https://ollama.com/install.sh | sh'

# Markdown viewer
md(){
    pandoc $1 > /tmp/$1.html
    xdg-open /tmp/$1.html
}

# Clone repository using name/repo pattern
gcl(){
    git clone git@github.com:$1
}

# Yazi
function y(){
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Change command
cmde(){
    local my_command="$1"
    lvim "$(readlink -f -- "$(command -v -- "$my_command")")"
}

remind() {
    local time="$1"
    shift
    local message="$*"
    echo "notify-send 'Reminder' '$message'; paplay /usr/share/sounds/freedesktop/stereo/complete.oga" | at "$time"
}
