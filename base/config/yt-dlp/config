# ~/.config/yt-dlp/config

# Safe filenames
--restrict-filenames
--output "%(title)s.%(ext)s"

# Keep temporary fragments/intermediate files out of ~/Videos and ~/Music
--paths "temp:~/.cache/yt-dlp/tmp"

# Explicit cleanup
--no-keep-fragments
--no-keep-video

# Metadata
--embed-metadata

# YouTube: avoid translated subtitle variants like en-en-US
--extractor-args "youtube:skip=translated_subs"
